---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout title={`Page not found — ${siteConfig.name}`}>
  <section class="error-page shell">
    <p class="eyebrow">404 / A loose end</p>
    <h1>This page wandered off.</h1>
    <p class="lede">The address may have changed, or perhaps it never existed.</p>
    <a class="button button--primary" href={import.meta.env.BASE_URL}>Return home</a>
  </section>
</BaseLayout>
