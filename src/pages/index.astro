---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import { siteConfig } from "../config/site";
import { sortTimeline } from "../utils/timeline";

const featured = sortTimeline(
  (await getCollection("timeline")).filter((entry) => entry.data.featured),
).slice(0, 3);
const baseURL = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${baseURL}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <section class="home-intro shell">
    <div class="home-portrait reveal" role="img" aria-label="Portrait placeholder">
      <span>{siteConfig.shortName}</span>
      <p>Replace this with<br />a photo of yourself.</p>
    </div>
    <div class="home-welcome reveal reveal-delay-1">
      <h1>Hey, thanks for dropping by!</h1>
      <p class="welcome-copy">
        My name is {siteConfig.name}. {siteConfig.intro}
      </p>
      <div class="button-row">
        <a class="button button--primary" href={asset("/me/")}>More about me</a>
        <a class="text-link" href={`mailto:${siteConfig.email}`}>Say hello <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="now-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Right now</p>
          <h2>What I’m interested in</h2>
        </div>
        <p class="now-note">A short, occasionally updated list.</p>
      </div>
      <dl class="now-grid">
        {siteConfig.now.map((item, index) => (
          <div>
            <dt><span>0{index + 1}</span>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section shell" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A few highlights</p>
        <h2 id="selected-work">Selected work</h2>
      </div>
      <a class="text-link" href={asset("/work/")}>View all work →</a>
    </div>
    <Timeline entries={featured} compact />
  </section>
</BaseLayout>
