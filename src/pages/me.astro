---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { siteConfig } from "../config/site";
import coffee1 from "../assets/coffee_1.jpg";
import coffee2 from "../assets/coffee_2.jpg";
import coffee3 from "../assets/coffee_3.jpg";
import hanoiPhoto from "../assets/hanoi_photo.jpg";
import singaporePhoto from "../assets/singapore_photo.jpg";
---

<BaseLayout
  title={`Me — ${siteConfig.name}`}
  description="Thanks for your interest in knowing me beyond my work :D Here I document all my hobbies outside research and technical projects. Let me know if we have something in common!"
>
  <PageIntro
    eyebrow="Personal website"
    title="Me"
    intro="Thanks for your interest in knowing me beyond my work :D On this page I document all my hobbies outside research and technical projects. Let me know if we have something in common!"
  />
  <section class="me-layout shell">
    <div class="prose">
      <h2>Where I’m from</h2>
      <div class="origin-grid">
        <article>
          <Image
            class="origin-photo"
            src={hanoiPhoto}
            alt="A view of Hanoi, Vietnam"
            widths={[640, 1000]}
            sizes="(max-width: 800px) 100vw, 45vw"
            loading="lazy"
          />
          <h3>Hanoi, Vietnam</h3>
          <p>
            Home sweet home! I spent the first 15 years of my life in this
            lovely city. This is where my personality and principles are
            rooted. I’d enjoy a bowl of beef pho, an iced coffee, or a glass of
            beer anytime whenever I’m back.
          </p>
        </article>
        <article>
          <Image
            class="origin-photo"
            src={singaporePhoto}
            alt="A view of Singapore"
            widths={[640, 1000]}
            sizes="(max-width: 800px) 100vw, 45vw"
            loading="lazy"
          />
          <h3>Singapore</h3>
          <p>
            Second home from home! I’m grateful to have lived in this exciting
            city throughout high school, where I first kindled my passion for
            the work I’m doing now. To me, nothing beats a sunny afternoon
            spent on the Marina Barrage!
          </p>
        </article>
      </div>
    </div>
  </section>

  <div class="hobby-sections">
    <section id="brewing" class="hobby-detail" aria-labelledby="brewing-heading">
      <div class="shell hobby-layout">
        <header>
          <h2 id="brewing-heading">Brewing</h2>
          <p>Coffee is one of the hobbies I spend the most time learning about.</p>
        </header>
        <dl class="hobby-notes">
          <div><dt>Preferred methods</dt><dd>Pour-over and Phin drip</dd></div>
          <div><dt>Currently</dt><dd>I’m experimenting with different types of fruity Americano. Give lime a try.</dd></div>
          <div><dt>Fun fact</dt><dd>It took me 32 espresso shots to get my first latte art.</dd></div>
        </dl>
        <div class="hobby-gallery" aria-label="Brewing photo gallery">
          <Image
            class="hobby-photo hobby-photo--coffee-1"
            src={coffee1}
            alt="Pour-over coffee brewing setup"
            widths={[420, 720]}
            sizes="(max-width: 800px) 78vw, 30vw"
            loading="lazy"
          />
          <Image
            class="hobby-photo"
            src={coffee2}
            alt="A coffee moment from my brewing hobby"
            widths={[420, 720]}
            sizes="(max-width: 800px) 78vw, 30vw"
            loading="lazy"
          />
          <Image
            class="hobby-photo"
            src={coffee3}
            alt="Coffee prepared during a brewing session"
            widths={[420, 720]}
            sizes="(max-width: 800px) 78vw, 30vw"
            loading="lazy"
          />
        </div>
      </div>
    </section>
    <section id="jamming" class="hobby-detail" aria-labelledby="jamming-heading">
      <div class="shell hobby-layout">
        <header>
          <h2 id="jamming-heading">Jamming</h2>
          <p>Guitar gives me a different way to slow down and pay attention.</p>
        </header>
        <dl class="hobby-notes">
          <div><dt>Instrument</dt><dd>Acoustic guitar</dd></div>
          <div><dt>Influences</dt><dd>Vietnamese indie (shout out to Keo Con!) and, recently, blues-pop artists like Eric Clapton.</dd></div>
          <div><dt>Currently practicing</dt><dd>Blues scale</dd></div>
        </dl>
      </div>
    </section>
    <section id="lifting" class="hobby-detail" aria-labelledby="lifting-heading">
      <div class="shell hobby-layout">
        <header>
          <h2 id="lifting-heading">Lifting</h2>
          <p>Training is a reliable part of my week and a simple way to measure progress.</p>
        </header>
        <dl class="hobby-notes">
          <div><dt>Split</dt><dd>Push–pull–legs</dd></div>
          <div><dt>Favorite movements</dt><dd>Nothing beats a dip with good form.</dd></div>
          <div><dt>Bench PR</dt><dd>205 lbs (yes, I’m almost there).</dd></div>
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>
